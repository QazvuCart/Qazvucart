# Placeholders only. Copy to .env and fill in. Never commit .env.
PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/qazvucart
# Long random string (32+ chars) used to sign admin sessions and CSRF tokens (Phase 4)
SESSION_SECRET=replace-with-long-random-string-at-least-32-chars
# Public site URL, used for product URLs in WhatsApp messages (Phase 5)
PUBLIC_SITE_URL=http://localhost:4200
# Business WhatsApp number: country code + number, digits only (Phase 5)
WHATSAPP_NUMBER=
INSTAGRAM_URL=
# Cloudinary. Uploads are UNSIGNED: create an unsigned upload preset (Settings > Upload > Upload presets,
# Signing mode "Unsigned") and put its name here. The cloud name and preset name are not secrets.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
# Optional but recommended: lets the API verify what was uploaded and delete removed images. Server only.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder that all uploads must live in (server-enforced)
CLOUDINARY_FOLDER=qazvucart/products
# Optional: create/update the admin automatically at startup (use on hosts without a shell). Password 12+ chars.
ADMIN_EMAIL=
ADMIN_PASSWORD=
